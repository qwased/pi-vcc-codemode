{
  "name": "pi-vcc-codemode",
  "version": "0.1.4",
  "description": "Codemode-aware conversation compactor for Pi - transcript-preserving structured summaries, no LLM calls",
  "license": "MIT",
  "main": "index.ts",
  "files": [
    "index.ts",
    "src/**/*.ts",
    "!src/**/*.bak",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "vcc",
    "compact",
    "compaction",
    "codemode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwased/pi-vcc-codemode.git"
  },
  "homepage": "https://github.com/qwased/pi-vcc-codemode#readme",
  "bugs": {
    "url": "https://github.com/qwased/pi-vcc-codemode/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --ignoreConfig --noEmit --skipLibCheck --module preserve --moduleResolution bundler --target ES2022 --types node index.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0 <2.0.0",
    "typebox": ">=1.1.24 <2.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
